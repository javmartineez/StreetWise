    "import osmnx as ox\n",
    "import networkx as nx\n",
    "import pandas as pd\n",
    "import re\n",
    "import difflib\n",
    "import os\n",
    "import matplotlib.pyplot as plt\n",
    "import excepciones as e\n",
    "\n",
    "from typing import Tuple"
   ]
